<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_dark">

    <EditText
        android:id="@+id/edit_ai_prompt"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="top|start"
        android:background="@drawable/bg_card_elevated"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_ai_ask"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Ask Gemini AI"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_primary"
        android:layout_marginBottom="8dp" />

    <ProgressBar
        android:id="@+id/progress_ai"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#0A0A0A"
        android:padding="10dp">

        <TextView
            android:id="@+id/txt_ai_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#EDEDED"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:textIsSelectable="true"
            android:text="Ask any question about Proxmox, shell commands, or troubleshooting..." />
    </ScrollView>
</LinearLayout>
