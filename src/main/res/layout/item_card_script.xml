<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/txt_script_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home Assistant OS"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/badge_script_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VM"
            android:textColor="@color/colorAccent"
            android:background="@drawable/bg_card_elevated"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_script_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Script description"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txt_script_command"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0A0A"
        android:padding="8dp"
        android:fontFamily="monospace"
        android:textColor="#33CC77"
        android:textSize="11sp"
        android:textIsSelectable="true"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_script_copy"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="📋 Copy Command"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/btn_primary"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btn_script_explain"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="🤖 AI Explain"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:background="@drawable/btn_secondary"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btn_script_docs"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="🌐 Docs"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:background="@drawable/btn_secondary" />
    </LinearLayout>
</LinearLayout>
