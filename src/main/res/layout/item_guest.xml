<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <!-- Top Row: VMID, Name, Type Badge, Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/badge_guest_vmid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textColor="@color/colorAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_card_elevated"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/txt_guest_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="guest-name"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/badge_guest_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RUNNING"
            android:textColor="@color/status_running"
            android:background="@drawable/bg_badge_running"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Subtitle: Node name & Cores & Memory -->
    <TextView
        android:id="@+id/txt_guest_specs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Node: pve | 2 vCPUs | 4.0 GB RAM"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <!-- Progress bars (CPU & RAM) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginRight="6dp">
            <TextView
                android:id="@+id/txt_guest_cpu_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CPU: 0.0%"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:layout_marginBottom="2dp" />
            <ProgressBar
                android:id="@+id/bar_guest_cpu"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/progress_horizontal_pve"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="6dp">
            <TextView
                android:id="@+id/txt_guest_mem_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RAM: 0.0%"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:layout_marginBottom="2dp" />
            <ProgressBar
                android:id="@+id/bar_guest_mem"
                style="?android:attr/progressBarStyleHorizontal"
                android:progressDrawable="@drawable/progress_horizontal_pve"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:progress="0" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions: Details button, Start/Stop quick button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txt_guest_uptime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Up: 2d 5h"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_guest_quick_power"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="▶ Start"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_success"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btn_guest_details"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Details →"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_secondary"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />
    </LinearLayout>
</LinearLayout>
